<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AotProbe</AssemblyName>
    <RootNamespace>KLink.Bot.AotProbe</RootNamespace>
    <!-- ⚠️⚠️ 这一行就是本工程存在的**全部理由**。
         它复刻 fyserver 的进程级策略（fyserver.csproj 里也写着这一条，为了 AOT 兼容）。
         任何用了反射式 JSON 而没有显式配 TypeInfoResolver 的代码，
         **在这个宿主里会抛异常，而在普通宿主里正常** ——
         所以 `ServerBridgeTest` / `NNPlay` 永远测不出这类问题。
         实测代价：一整局 AI 静默退回贪心，而且看起来像"AI 很笨"。 -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\KLink.Bot\KLink.Bot.csproj" />
  </ItemGroup>
</Project>
