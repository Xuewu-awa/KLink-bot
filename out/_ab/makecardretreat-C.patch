+    /// <summary>
+    /// 「撤回」逐张主体 —— <see cref="DoMakeCardRetreat"/> 的落地部分
+    /// （蓝图 `ApplyMakeCardRetreat` `:3530-3716` 的那一段）。判据与出处见调用方的注释。
+    /// </summary>
+    private void RetreatOneCard(EffectContext c, CardInstance card)
+    {
+        // 前置条件②（`:3555`/`:3653`）：不在棋盘上 ⇒ 什么都不做（蓝图只 log 一句）。
+        // 蓝图这里是 `location ∈ {5,6,7}`；`IsLocatedOnBoard` 是同一判据再排掉 HQ
+        // （HQ 这份位置卡恰好也在 5/6，见 `Engine/Enums.cs:20-26`），与"撤单位"一致。
+        if (!IsLocatedOnBoard(card))
+        {
+            return;
+        }
+
+        // 事件链（`:3587-3730`）：
+        //   · `IsActionProcess()` 为假时**整段不发** —— 内核没有这个分流，效果路径上
+        //     按"恒真"处理（同一个取舍见 `CardApi.SpawnCardToBoard` 对 `:734` 的处理）。
+        //   · `OnBeforeRetreat` 在**整个卡池里一个实现都没有**（`docs/card-effects.json`
+        //     无该事件键）⇒ 它那条 `stopAction` 取消门永远不会命中；照发一次保持结构。
+        //   · 事件触发点 **54 = `OnOtherCardRetreat`**（`docs/触发点普查表.md:65`），
+        //     卡池里 2 张有实现（`card_unit_typhoon_mk_ib` 触发抽牌 / `card_event_decoy_tactics`）。
+        //     蓝图自己**忽略**它的 `stopAction`（`:3725`/`:3730` 两条分支都回内层循环），
+        //     内核 `FireTrigger` 也没有出参 ⇒ 两边一致。
+        if (!card.IsSuppressed)
+        {
+            FireTrigger("OnBeforeRetreat", card, card.Owner);
+        }
+
+        FireTrigger("OnOtherCardRetreat", card, card.Owner);
+
+        // 前线(7) ⇒ 退回**本方半场**（支援线 = `side.HqOf()`，5/6）—— 前提是半场没满
+        // （容量 5、**含 HQ**，与 `DoIsLocationFull` 同一口径）。
+        if (card.Location == CardLocation.BoardFrontline)
+        {
+            CardLocation support = card.Owner.HqOf();
+            bool full = c.State.Cards(card.Owner, support).Count >= GameState.HalfBoardCapacity;
+            if (!full)
+            {
+                c.State.Move(card, support);
+                return;
+            }
+        }
+
+        // 其余全部（本来就在半场 5/6、或前线但半场满）⇒ 退回**拥有者手牌**（蓝图 `:3703`）。
+        DoMoveUnitFromBoardToOwnersHand(c, card, new object?[] { card });
+    }
