+    /// ⇒ 无处可减；它也不改变"卡去哪"，不影响落点。
+    ///
+    /// ## 实参形状普查（`docs/card-ir.json`，2026-10-03；含 `locals` 体）
+    ///
+    /// **36 个调用点 / 35 张卡，只有一种形状**：
+    /// <list type="bullet">
+    /// <item>`recv` = `cardFunction` —— **36/36**（恒为施法的那张牌自己）；</item>
+    /// <item>实参个数 = **2** —— 36/36；</item>
+    /// <item>`a[0]` 全是**变量**（卡对象数组）：`K2Node_MakeArray_Array` ×27、
+    ///   `CallFunc_GetAllCardsInFrontline_cards` ×2、`K2Node_MakeArray_Array_1` ×2、
+    ///   `affectedUnits` / `cardsToRetreat` / `unitsToRetreat` /
+    ///   `CallFunc_GetCardsInFrontlineBySide_cards` / `CallFunc_GetCardsOnBoardBySide_cards`
+    ///   各 ×1（其中 1 个带 `ctx`）；</item>
+    /// <item>`a[1]` 全是 `cardID`（`instigatorID`）。</item>
+    /// </list>
+    /// 两个在 `locals` 里的调用点：`card_event_merchant_navy` 与 `card_unit_bm_13n_us6`
+    /// 的 `OnOtherCardAttacks`。⇒ **不存在"同一原语多种形状"的坑**。
+    ///
+    /// ⚠️ 不注册 `ApplyMakeCardRetreat`：它是 `BP_CardFunctions` 的**全局**函数，
+    /// 只被上面这段分发体调用，而内核根本不执行全局蓝图函数体（那部分没有 IR），
+    /// 所以它永远不会成为运行时调用点（`DispatchGap` 的缺口集合里也没有它）。
+    /// </summary>
+    private object? DoMakeCardRetreat(EffectContext c, object?[] a)
+    {
+        // ① 取 `a[0]` 那个数组。⚠️ **不能用 `EvalArray(r, a)`**：它的兜底是
+        //    "接收者本身是一张卡时当成单元素数组"，而这里的 `r` 恒为 `cardFunction`
+        //    （= 施法的那张牌自己）⇒ 目标数组为空/null 时会**把施法牌自己撤了**。
+        //    `AsCardOrId` 同时认卡对象与整数 cardID（本族别处的两种元素类型）。
+        var targets = new List<CardInstance>();
+        if (a.Length > 0)
+        {
+            if (a[0] is System.Collections.IList arr)
+            {
+                foreach (object? v in arr)
+                {
+                    if (AsCardOrId(c, v) is { } one)
+                    {
+                        targets.Add(one);
+                    }
+                }
+            }
+            else if (AsCardOrId(c, a[0]) is { } single)
+            {
+                targets.Add(single);
+            }
+        }
+
+        // ② 一遍循环分两批（蓝图 `:25790-25888`）：`cantRetreat` 的卡**直接不撤**，
+        //    其余的按"是不是在前线(7)"分。
+        var supportBatch = new List<CardInstance>();
+        var frontBatch = new List<CardInstance>();
+        foreach (var card in targets)
+        {
+            if (HasCustomAbility(card, "cantRetreat"))
+            {
+                continue;
+            }
+
+            (card.Location == CardLocation.BoardFrontline ? frontBatch : supportBatch).Add(card);
+        }
+
+        // ③ 顺序**不能反**（蓝图 `:25823` 在 `:25850` 之前）：半场那批先退走 ⇒ 腾出槽位，
+        //    前线那批才可能有位置退；反过来会让"半场刚好满"的局面得到与客户端不同的落点。
+        // ④ 批内按 `SortCardsByLocationNumber`（`:3495`，槽位序）逐张结算 ——
+        //    前线那批是**逐张**判"半场满没满"的（前一张退进去后可能就满了）。
+        foreach (var batch in new[] { supportBatch, frontBatch })
+        {
+            foreach (var card in batch.OrderBy(x => x.LocationNumber))
+            {
+                RetreatOneCard(c, card);
+            }
+        }
+
+        return null;
+    }
