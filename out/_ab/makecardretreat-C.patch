+    /// <summary>
+    /// 端到端复刻 `replay-770857` #28 t9：`card_event_aa_barrage`
+    /// （卡面「Target air unit must retreat. Give your HQ +2 defense.」，`docs/cards.json`；
+    /// 人类当时的目标是 `card_unit_j2m_raiden`，日本战斗机）。
+    ///
+    /// IR 只有三步（`docs/card-ir.json`）：`i=10 setArray([target])`
+    /// → `i=30 MakeCardRetreat(那个数组, cardID)` → `i=84 ChangeDefense(本方 HQ, +2)`。
+    ///
+    /// <list type="number">
+    /// <item>目标在**敌方半场**（= 770857 的局面）⇒ 蓝图走 `:3714` ⇒ **退回拥有者手牌**
+    ///   （所以人类 #35 才可能再打一次同一张卡；内核修复前 #35 被判
+    ///   「重复记录（该 cardID 已在场）」）。</item>
+    /// <item>目标在**前线**、敌方半场只有 HQ（没满）⇒ 蓝图走 `:3692`
+    ///   ⇒ 落到 `BoardHqRight`、**不进手牌**。这一条专门守"不是一律退手牌"。</item>
+    /// </list>
+    /// </summary>
+    private static string? AaBarrageRetreatEndToEnd(CardDatabase db)
+    {
+        const string card = "card_event_aa_barrage";
+        const string fighter = "card_unit_j2m_raiden";
+        if (db.Find(card) is null || db.Find(fighter) is null)
+        {
+            return $"卡库里缺 {card} / {fighter}";
+        }
+
+        // ① 770857 #28 的局面：目标在敌方**半场** ⇒ 退回敌方手牌
+        {
+            var (engine, state) = DeploymentBoard(db);
+            var target = state.CreateWithId(fighter, Side.Right, 42, CardLocation.BoardHqRight, 1);
+            var order = state.CreateWithId(card, Side.Left, 2, CardLocation.HandLeft, 0);
+
+            int hqBefore = state.HqDefense(Side.Left);
+            if (!engine.CanPlay(order, out string why))
+            {
+                return $"打不出 {card}：{why}";
+            }
+
+            if (!engine.PlayCard(order, target))
+            {
+                return $"{card} 打出失败";
+            }
+
+            if (state.UnimplementedCalls.ContainsKey("MakeCardRetreat"))
+            {
+                return "① 走 VM 的这次调用仍然没进派发表（`UnimplementedCalls` 里有 `MakeCardRetreat`）"
+                     + Dump(state, ("未实现", Unimpl(state)));
+            }
+
+            if (target.Location != CardLocation.HandRight)
+            {
+                return $"① 半场上的目标应被撤回**拥有者手牌** HandRight，实际 {target.Location}"
+                     + Dump(state, ("未实现", Unimpl(state)));
+            }
+
+            int hqAfter = state.HqDefense(Side.Left);
+            if (hqAfter != hqBefore + 2)
+            {
+                return $"① 本方 HQ 应 +2（IR i=84 `ChangeDefense(本方HQ, 2)`），实际 {hqBefore} → {hqAfter}";
+            }
+        }
+
+        // ② 目标在**前线**、敌方半场没满 ⇒ 退回敌方半场（不是手牌）
+        {
+            var (engine, state) = DeploymentBoard(db);
+            var target = state.CreateWithId(fighter, Side.Right, 42, CardLocation.BoardFrontline, 0);
+            var order = state.CreateWithId(card, Side.Left, 2, CardLocation.HandLeft, 0);
+
+            if (!engine.CanPlay(order, out string why))
+            {
+                return $"打不出 {card}：{why}";
+            }
+
+            if (!engine.PlayCard(order, target))
+            {
+                return $"{card} 打出失败";
+            }
+
+            if (target.Location != CardLocation.BoardHqRight)
+            {
+                return $"② 前线上的目标应退到**其拥有者半场** BoardHqRight（蓝图 :3692），实际 {target.Location}"
+                     + Dump(state, ("未实现", Unimpl(state)));
+            }
+
+            if (state.Hand(Side.Right).Contains(target))
+            {
+                return "② 前线单位在己方半场有空位时**不该**进手牌（蓝图 :3692 只退一格）";
+            }
+        }
+
+        return null;
+    }
