+    private static string? MakeCardRetreatBranches(CardDatabase db)
+    {
+        const string unit = "card_unit_2nd_parachute";
+        if (db.Find(unit) is null)
+        {
+            return $"卡库里缺 {unit}";
+        }
+
+        // ① 前线 ⇒ 本方半场（蓝图 :3672-3692）。⚠️ 不是手牌。
+        {
+            var (engine, state) = DeploymentBoard(db);
+            var front = state.CreateWithId(unit, Side.Left, 20, CardLocation.BoardFrontline, 0);
+            var ctx = new EffectContext { Engine = engine, State = state, Self = front, Controller = Side.Left };
+
+            engine.Api.InvokeByName("MakeCardRetreat", null,
+                new object?[] { new List<CardInstance> { front }, front.CardId }, ctx, out bool handled);
+            if (!handled)
+            {
+                return "派发表里没有 `MakeCardRetreat`（**修复前就是这个状态**：整段撤回静默不发生）";
+            }
+
+            if (front.Location != CardLocation.BoardHqLeft)
+            {
+                return $"① 前线单位应退到**本方半场** BoardHqLeft，实际 {front.Location}"
+                     + Dump(state, ("未实现", Unimpl(state)));
+            }
+
+            if (state.Hand(Side.Left).Contains(front))
+            {
+                return "① 半场有空位时**不该**进手牌（「一律退回手牌」是这个 bug 的误判）";
+            }
+        }
+
+        // ② 已在半场 ⇒ 拥有者手牌
+        {
+            var (engine, state) = DeploymentBoard(db);
+            var sitting = PutOnBoard(state, unit, Side.Left, 20, 1);
+            var ctx = new EffectContext { Engine = engine, State = state, Self = sitting, Controller = Side.Left };
+
+            engine.Api.InvokeByName("MakeCardRetreat", null,
+                new object?[] { new List<CardInstance> { sitting }, sitting.CardId }, ctx, out bool handled);
+            if (!handled)
+            {
+                return "派发表里没有 `MakeCardRetreat`";
+            }
+
+            if (sitting.Location != CardLocation.HandLeft)
+            {
+                return $"② 已在本方半场的单位应退回拥有者手牌 HandLeft，实际 {sitting.Location}"
+                     + Dump(state, ("未实现", Unimpl(state)));
+            }
+        }
+
+        // ③ 前线 + 本方半场满（HQ 1 格 + 4 个单位 = 上限 5）⇒ 退手牌
+        {
+            var (engine, state) = DeploymentBoard(db);
+            for (int k = 0; k < 4; k++)
+            {
+                PutOnBoard(state, unit, Side.Left, 30 + k, 1 + k);
+            }
+
+            var front = state.CreateWithId(unit, Side.Left, 20, CardLocation.BoardFrontline, 0);
+            var ctx = new EffectContext { Engine = engine, State = state, Self = front, Controller = Side.Left };
+
+            engine.Api.InvokeByName("MakeCardRetreat", null,
+                new object?[] { new List<CardInstance> { front }, front.CardId }, ctx, out bool handled);
+            if (!handled)
+            {
+                return "派发表里没有 `MakeCardRetreat`";
+            }
+
+            if (front.Location != CardLocation.HandLeft)
+            {
+                return $"③ 前线单位在本方半场已满时应退回手牌，实际 {front.Location}"
+                     + Dump(state, ("未实现", Unimpl(state)));
+            }
+        }
+
+        // ④ 两类"零变化"：不在棋盘上 / 有 `cantRetreat`
+        {
+            var (engine, state) = DeploymentBoard(db);
+            var inHand = state.CreateWithId(unit, Side.Left, 20, CardLocation.HandLeft, 0);
+            var front = state.CreateWithId(unit, Side.Left, 21, CardLocation.BoardFrontline, 0);
+            engine.Api.CustomAbilityAdd(front, "cantRetreat", null);
+
+            var ctx = new EffectContext { Engine = engine, State = state, Self = front, Controller = Side.Left };
+
+            engine.Api.InvokeByName("MakeCardRetreat", null,
+                new object?[] { new List<CardInstance> { inHand, front }, inHand.CardId }, ctx, out bool handled);
+            if (!handled)
+            {
+                return "派发表里没有 `MakeCardRetreat`";
+            }
+
+            if (inHand.Location != CardLocation.HandLeft)
+            {
+                return $"④ 不在棋盘上的卡不该被移动（蓝图 :3555），实际 {inHand.Location}";
+            }
+
+            if (front.Location != CardLocation.BoardFrontline)
+            {
+                return $"④ 带 `cantRetreat` 的卡不该被撤回（蓝图 :25790-25792），实际 {front.Location}";
+            }
+        }
+
+        return null;
+    }
