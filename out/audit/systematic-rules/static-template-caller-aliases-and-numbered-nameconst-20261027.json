  "decoder_patch_source": "\"\"\"RULE-483: EX_NameConst preserves comparison index and serialized number.\nCurrent opcode21 handler copies dword0/dword2 into runtime FName; dword1\nis not read into its output. Other syntax remains delegated unchanged.\n\"\"\"\nfrom pathlib import Path\nimport importlib.util,sys\nsys.path.insert(0,str(Path(\"D:/Codex Workshop/KLink-bot/tools\")))\nfrom audit_script_nameconst import read_name_const\nsp=importlib.util.spec_from_file_location('base438',Path(__file__).with_name('runtime-kismet-subset-438.py'));base=importlib.util.module_from_spec(sp);sp.loader.exec_module(base)\nclass Decoder(base.Decoder):\n def expr(self):\n  if self.raw[self.at]==0x21:\n   name=read_name_const(self.raw,self.at);self.at=name.end\n   return dict(Inst='NameConst',Value=self.fname(name.comparison,name.number))\n  return super().expr()\n",
