  "findings": {
    "local_gate": "ReceiveActionAttackCard1569 true(local) skips ExecuteAttackCard; false(remote)2326 executes helper once,2398 rejoins1583. This does not skip later bookkeeping.",
    "fields": "MovementLeft,AttackLeft,HasEverAttacked are parsed into locals but not directly written to card state. Location/defense/Shock keys recognized and ignored here. Remote helper can still change state; model does not claim cards unchanged under real helper.",
    "notifiers": "Owned-side damage notices include signed/zero amount without positive gate. NotifyOnCardDealDamage/Destroyed wrappers forward to DailyMissionsReceiver. Full daily-mission receiver effects not certified.",
    "ledger": "Payload attackerDestroyed/defenderDestroyed control global/per-side appends and per-turn unique list. Attack buff!=0 removes saved end-of-turn actions first; each destruction invokes notifier and DestroyedCountChanged multicast. No numeric damage/death reconciliation gate in this receiver.",
    "scope": "Campaign-only OnOtherCardDestroyed branch is guarded by exact match_type campaign and not-local-turn. Excluded from PvP model; no campaign restoration performed.",
    "removal": "ApplyRemoveCardFromBoard1009B has its own notifier. NotifyRemoveCardFromBoard and NotifyDestroyUnit use distinct interface methods; actual Remove handler enters13987 -> AddSubActionRemoveCardFromBoard. Builders generate distinct ZActionRemoveCardFromBoard vs ZActionDestroyUnit."
  },
  "comparison": {
    "file": "src/KLink.Bot/Engine/MatchEngine.cs",
    "current": "ExecuteDestroyed records ledger before destruction callbacks. Attack receiver bookkeeping occurs after attack generation/remote helper at its boundary; shared paths and nested callbacks need full phase reconciliation.",
    "change": "Correct misleading source comment only; no new runtime behavior or extra ledger receipt. Directly adding receipt bookkeeping would double append global/per-side history under current implementation.",
    "remaining": "Audit all destruction/removal generation/receipt paths and effect readers before changing shared ledger timing or action sequence.",
