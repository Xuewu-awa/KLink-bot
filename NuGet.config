<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 包源配置。

  上游 `klink` 仓库里这份文件把 `tem/nuget-local`（用 Python ssl 预先下好的包）
  放在首位，因为那台机器上 schannel 过不了代理、api.nuget.org 被重定向到
  nuget.azure.cn、NuGet 客户端走不通。

  本独立仓库**不带** `tem/nuget-local`（那是宿主侧产物），所以这里只留 nuget.org。
  如果你在受限网络里构建失败，请照上游的做法加一个本地包源，例如：

      <add key="local" value="..\tem\nuget-local" />

  或者直接在能上网的机器上 `dotnet restore`，再把 ~/.nuget/packages 拷过来。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
